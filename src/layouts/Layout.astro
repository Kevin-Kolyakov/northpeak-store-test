---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title} | Northpeak</title>
	</head>
	<body>
		<header class="site">
			<a class="logo" href="/" aria-label="Northpeak home">NORTHPEAK</a>
			<nav class="main" aria-label="Main">
				<a href="/collections/mens-jackets">Men</a>
				<a href="/collections/womens-jackets">Women</a>
				<a href="/collections/sweaters-layers">Sweaters &amp; Layers</a>
				<a href="/collections/accessories">Accessories</a>
			</nav>
			<form class="search" action="/search" role="search">
				<label for="q" hidden>Search products</label>
				<input id="q" name="q" type="search" placeholder="Search products" aria-label="Search products" />
				<button type="submit">Search</button>
			</form>
			<a class="account-link" id="account-link" href="/account/login">Sign in</a>
			<a class="wishlist-link" href="/wishlist">Wishlist</a>
			<a class="cart-link" href="/cart">Cart</a>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site">
			<p>Northpeak is a fictional sandbox storefront built to test website QA tooling. Not a real store — nothing here ships.</p>
		</footer>
		<div id="cookies" hidden>
			<p>We use cookies to personalise content and analyse traffic.</p>
			<button id="ck-manage">Manage preferences</button>
			<button id="ck-ok" class="primary">Accept all cookies</button>
		</div>
		<script>
			const banner = document.getElementById("cookies") as HTMLElement;
			if (!sessionStorage.getItem("np-cookies")) {
				banner.hidden = false;
			}
			function dismiss() {
				sessionStorage.setItem("np-cookies", "1");
				banner.hidden = true;
			}
			const accept = document.getElementById("ck-ok") as HTMLButtonElement | null;
			if (accept) {
				accept.type = "button";
			}
			document.getElementById("ck-ok")?.addEventListener("click", dismiss);
			document.getElementById("ck-manage")?.addEventListener("click", dismiss);
		</script>
		<script>
			import type { Account } from "../lib/account";

			const raw = localStorage.getItem("np-account");
			if (raw) {
				const account: Account = JSON.parse(raw);
				const link = document.getElementById("account-link") as HTMLAnchorElement;
				link.textContent = account.name || account.email;
				link.href = "/account";
			}
		</script>
		<script>
			const WISHLIST_KEY = "np-wishlist";

			function getWishlist(): string[] {
				return JSON.parse(localStorage.getItem(WISHLIST_KEY) || "[]");
			}

			function paint(button: HTMLElement, saved: boolean) {
				button.classList.toggle("saved", saved);
				button.textContent = saved ? "♥ Saved" : "♡ Save for later";
			}

			const wishlist = getWishlist();
			document.querySelectorAll<HTMLElement>("[data-wishlist-slug]").forEach((button) => {
				paint(button, wishlist.includes(button.dataset.wishlistSlug!));
			});

			document.addEventListener("click", (e) => {
				const button = (e.target as HTMLElement).closest<HTMLElement>("[data-wishlist-slug]");
				if (!button) return;
				const slug = button.dataset.wishlistSlug!;
				const current = getWishlist();
				const saved = current.includes(slug);
				const next = saved ? current.filter((s) => s !== slug) : [...current, slug];
				localStorage.setItem(WISHLIST_KEY, JSON.stringify(next));
				paint(button, !saved);
			});
		</script>
	</body>
</html>
